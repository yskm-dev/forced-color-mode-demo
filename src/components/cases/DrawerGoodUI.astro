---

---

<div class="drawer-good-demo">
  <button
    class="drawer-good__trigger"
    id="drawer-good-trigger"
    aria-expanded="false"
    aria-controls="drawer-good-panel"
  >
    メニューを開く
  </button>

  <div class="drawer-good-scene">
    <dialog
      class="drawer-good"
      id="drawer-good-panel"
      aria-label="ナビゲーションメニュー（Good UI）"
      aria-modal="true"
    >
      <div class="drawer-good__header">
        <h3 class="drawer-good__title">メニュー</h3>
        <button
          class="drawer-good__close"
          id="drawer-good-close"
          aria-label="メニューを閉じる">✕</button
        >
      </div>
      <nav>
        <ul class="drawer-good__nav" role="list">
          <li>
            <a href="#how-to-enable" class="drawer-good__nav-item">有効化手順</a
            >
          </li>
          <li>
            <a href="#case-1" class="drawer-good__nav-item"
              >Case1:ラジオボタン</a
            >
          </li>
          <li>
            <a href="#case-2" class="drawer-good__nav-item">Case2:ドロワー</a>
          </li>
          <li>
            <a href="#case-3" class="drawer-good__nav-item"
              >Case3:ボタン優先度</a
            >
          </li>
          <li>
            <a href="#case-4" class="drawer-good__nav-item"
              >Case4:アイコン付きボタン</a
            >
          </li>
        </ul>
      </nav>
    </dialog>
  </div>
</div>

<script>
  function initDrawerGood() {
    const trigger = document.getElementById(
      "drawer-good-trigger",
    ) as HTMLButtonElement;
    const panel = document.getElementById(
      "drawer-good-panel",
    ) as HTMLDialogElement;
    const closeBtn = document.getElementById(
      "drawer-good-close",
    ) as HTMLButtonElement;

    if (!trigger || !panel || !closeBtn) return;

    function open() {
      panel.showModal();
      trigger?.setAttribute("aria-expanded", "true");
    }

    function close() {
      panel.close();
      trigger?.setAttribute("aria-expanded", "false");
    }

    trigger.addEventListener("click", open);
    closeBtn.addEventListener("click", close);
    panel.addEventListener("click", (e) => {
      if (e.target === panel) close();
    });
  }
  initDrawerGood();
</script>

<style lang="scss">
  .drawer-good-demo {
    position: relative;
  }

  .drawer-good-scene {
    position: relative;
  }

  .drawer-good__trigger {
    @include button-reset;
    background-color: $color-primary;
    color: $color-text-on-primary;
    padding: $space-sm $space-lg;
    border-radius: $border-radius-md;
    font-size: $font-size-sm;
    font-weight: $font-weight-semibold;
    margin-bottom: $space-md;
    border: 1px solid transparent;
  }

  .drawer-good {
    top: 0;
    right: 0;
    left: auto;
    height: 100%;
    max-height: 100%;
    border: none;
    border-left: 2px solid transparent;
    bottom: 0;
    width: 280px;
    z-index: $z-drawer;
    background-color: $color-bg;
    padding: $space-lg;
    transform: translateX(100%);
    transition: transform 0.3s ease;
    visibility: visible;

    // Bad: box-shadow のみで境界を表現
    box-shadow: -8px 0 24px $color-shadow;

    &[open] {
      transform: translateX(0);
    }

    &::backdrop {
      background: rgba(0, 0, 0, 0.2);
    }
  }

  .drawer-good__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: $space-lg;
    padding-bottom: $space-md;
    border-bottom: 1px solid $color-border;

    @media (forced-colors: active) {
      border-bottom: 1px solid currentColor;
    }
  }

  .drawer-good__title {
    font-size: $font-size-lg;
    font-weight: $font-weight-semibold;
  }

  .drawer-good__close {
    @include button-reset;
    width: 32px;
    height: 32px;
    border-radius: $border-radius-full;
    color: $color-text-muted;
    font-size: $font-size-base;

    &:hover {
      background-color: $color-surface;
    }
  }

  .drawer-good__nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .drawer-good__nav-item {
    display: block;
    padding: $space-sm $space-md;
    color: $color-text;
    text-decoration: none;
    border-radius: $border-radius-sm;
    font-size: $font-size-base;

    &:hover {
      background-color: $color-surface;
      text-decoration: none;
    }
  }
</style>
